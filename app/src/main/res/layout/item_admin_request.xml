<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/adminRequestStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: overdue"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adminBorrower"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Borrower:" />

    <TextView
        android:id="@+id/adminOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Owner:" />

    <TextView
        android:id="@+id/adminReturnDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Return Date:" />

    <TextView
        android:id="@+id/adminReturnedDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Returned Date:" />

    <Button
        android:id="@+id/adminRequestAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#fff3c2"
        android:textColor="@color/black"
        android:text="Mark Returned" />

</LinearLayout>