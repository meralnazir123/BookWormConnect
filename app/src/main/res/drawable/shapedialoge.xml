<?xml version="1.0" encoding="utf-8"?>
<!--
    shapedialoges.xml — Rounded rectangle shape for dialog backgrounds
    Place in: app/src/main/res/drawable/shapedialoges.xml
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- White background -->
    <solid android:color="#FFFFFF"/>

    <!-- Rounded corners -->
    <corners android:radius="16dp"/>

    <!-- Subtle border -->
    <stroke
        android:width="1dp"
        android:color="#E0D5D0"/>

    <!-- Padding inside shape -->
    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp"/>

</shape>