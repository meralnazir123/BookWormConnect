<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_layout.xml — General purpose dialog layout for BookWormConnect
    Used for confirmation dialogs, info popups, or rating dialogs.
    Place in: app/src/main/res/layout/dialog_layout.xml
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- Dialog title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:paddingBottom="12dp"/>

    <!-- Dialog message / body -->
    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Are you sure you want to proceed?"
        android:textSize="14sp"
        android:textColor="#757575"
        android:paddingBottom="20dp"
        android:lineSpacingMultiplier="1.3"/>

    <!-- Optional text input (e.g. for reason/note) -->
    <EditText
        android:id="@+id/dialogInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Add a note (optional)"
        android:textSize="14sp"
        android:padding="10dp"
        android:background="@android:color/transparent"
        android:visibility="gone"/>

    <!-- Button row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="8dp">

        <!-- Cancel -->
        <Button
            android:id="@+id/dialogCancelBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#6D4C41"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_marginEnd="8dp"/>

        <!-- Confirm -->
        <Button
            android:id="@+id/dialogConfirmBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm"
            android:backgroundTint="#6D4C41"
            style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>

</LinearLayout>