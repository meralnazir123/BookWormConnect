<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_chat.xml — BookWormConnect
    Full chat screen layout:
      • Toolbar with book title
      • RecyclerView for message bubbles
      • Divider
      • Label for chip area ("Quick Questions" or "Quick Replies")
      • HorizontalScrollView for Question chips (sender only, shown dynamically)
      • HorizontalScrollView for Answer chips  (receiver only, shown dynamically)
      • Bottom input bar: EditText + Send button
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg4">

    <!-- ── Toolbar ────────────────────────────────────────────────── -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/chatToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:elevation="4dp"
        app:titleTextColor="@android:color/white"
        app:subtitleTextColor="#CCFFFFFF"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="Back"/>

    <!-- ── Progress bar (shown while loading) ────────────────────── -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- ── Message list ───────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>

    <!-- ── Thin divider ───────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"/>

    <!-- ── Chip section label ─────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvChipLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:text="Quick Questions"
        android:textSize="11sp"
        android:textColor="#888888"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:visibility="gone"/>

    <!-- ── SENDER: Question chips (horizontal scroll) ─────────────── -->
    <HorizontalScrollView
        android:id="@+id/scrollQuestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupQuestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:chipSpacingHorizontal="6dp"/>

    </HorizontalScrollView>

    <!-- ── RECEIVER: Answer chips (horizontal scroll) ─────────────── -->
    <HorizontalScrollView
        android:id="@+id/scrollAnswers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupAnswers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:chipSpacingHorizontal="6dp"/>

    </HorizontalScrollView>

    <!-- ── Bottom input bar ───────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/inputBackground"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <!-- Custom text input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="24dp"
            app:boxCornerRadiusTopEnd="24dp"
            app:boxCornerRadiusBottomStart="24dp"
            app:boxCornerRadiusBottomEnd="24dp"
            app:boxStrokeColor="@color/primary"
            android:hint="Type a message…">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextCustomMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                android:inputType="textMultiLine|textCapSentences"
                android:textSize="14sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@null"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Send button -->
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_send_button"
            android:src="@drawable/ic_send"
            android:contentDescription="Send"
            android:padding="10dp"/>

    </LinearLayout>

</LinearLayout>